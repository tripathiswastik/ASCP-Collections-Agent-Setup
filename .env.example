# Live Oracle Database Credentials
ORACLE_USER="apps"
ORACLE_PASSWORD="your_apps_password"
ORACLE_HOST="your-oracle-host.company.com"
ORACLE_PORT="1521"
ORACLE_SERVICE_NAME="EBSDB"

# Oracle RAC Multi-Node Configuration
ORACLE_SCAN_ADDRESS="ebs-cluster-scan.company.com"
ORACLE_IS_RAC="true"

# Durable State Checkpointer (PostgresSaver for fault tolerance across container crashes)
POSTGRES_CONNECTION_STRING="postgresql://ascp_user:your_secure_password@localhost:5432/ascp_db"
ENVIRONMENT="production"

# Disable Simulation Mode
USE_MOCK_DB="False"
